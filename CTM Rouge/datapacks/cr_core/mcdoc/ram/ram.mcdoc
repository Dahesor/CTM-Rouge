use::java::util::text::Text
use::java::world::item::ItemStack
use::mcdoc::level::cell::Cell
use::mcdoc::level::cell::Teleporters
use::mcdoc::level::cell::CellConnetion
use::mcdoc::custom_data::shopStock
use::ram::player_map::PlayerMap
use::ram::player_map::PlayerMapLevel
use::ram::dialogmix::DialogMix
use::core::team::Team

dispatch minecraft:storage["ram:"] to struct Ram{
    stack?: [Ram],
    text?: Text,
    text2?: Text,
    disjoint?: DisJoint,
    list?: [any],
    i?: struct{i?:any},
    item?: ItemStack,
    tp?: [Teleporters],
    rm?: [CellConnetion],
    map?: [Cell],
    stair_list?: [Cell],
    pos?: vec3,
    struct_res?: struct{res?: #[id="structure"] string},
    place?: StructurePlaceVars,
    map_cell?: Cell,
    broadcast?: struct{self?: Text, teammate?: Text, enemy?: Text, spectator?: Text},
    emptyPlMap?: PlayerMap,
    tpPlMap?: PlayerMap,
    thisPlMap?: PlayerMapLevel,
    dialog?: struct{
        dialog?: DialogMix,
    },
    color?: Team,
    dec?: struct{
        [(DecListNames|string)]?: DecList,
    },
    shopStock?: shopStock,
}

enum(string) DecListNames{
    u = "u",
}

struct DisJoint{
    data?: [int],
    input_1?: int,
    input_2?: int,
    edges?: [Edge],
    forbidden_edges?: [Edge],
    rooms?: [CellConnetion],
    single_edge?: Edge,
    x1?: int,
    z1?: int,
    x2?: int,
    z2?: int,
}

struct StructurePlaceVars{
    id?: #[id="structure"] string,
    rotation?: ("none"|"180"|"clockwise_90"|"counterclockwise_90"),
    mirror?: ("none"|"left_right"|"front_back"),
    ...vec3,
}

struct vec3{
    x?: int,
    y?: int,
    z?: int,
}

struct Edge{
    from?: int,
    to?: int,
}

struct DecList{
    Fixed?: [
        struct{
            x_shift?: int,
            z_line?: int,
            text?: string,
        }
    ],
}