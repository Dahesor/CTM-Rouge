use::core::team::Team

/// A unit on the map
struct Cell {
    /// Type of this cell
    type?: CellTypes,
    /// If this cell is a special room, which type of special room is it
    special?: SpecialTypes,
    /// Where this cell is located
    meta?: CellMeta,
    /// Which directions are connected
    connections?: CellConnetion,
    /// Id of this room in the grid of the current floor
    rid?: int,
    /// Universal id of this room across all floors
    urid?: int,
    normal_room?: struct{
        /// Is finished by players
        is_finished?: boolean,
    },
    spawn_room?: struct{
        owner?: Team,
    },
    stair_room?: stair_room,
}

struct CellConnetion{
    pos_x?: boolean,
    neg_x?: boolean,
    pos_z?: boolean,
    neg_z?: boolean,
    floor_up?: boolean,
    floor_down?: boolean,
    anyconnect?: boolean,
}

enum(string) CellTypes{
    /// Undicided
    Void = "void",
    /// Nothing
    Empty = "empty",
    /// Regular Room
    Room = "room",
    /// Large Room
    LargeRoom = "large_room",
    /// Connetions to the upper or lower floor
    Stairs = "stairs",
    /// Spawn
    Spawn = "spawn",
    /// Special Room
    Special = "special",
    /// Shop
    Shop = "shop",
    /// TP
    Teleporter = "teleporter",
}

enum(string) SpecialTypes{
    f1secrs = "f1_secrect_exit",
    light_blue_wool = "light_blue_wool",
    white_wool = "white_wool",
    light_gray_wool = "light_gray_wool",
    green_wool = "green_wool",
    f0secrs = "f0_fall_exit",
    yellow_wool = "yellow_wool",
    magenta_wool = "magenta_wool",
    black_wool = "black_wool",
    gray_wool = "gray_wool",
}

struct stair_room{
    x?: int,
    z?: int,
    to_floor?: int,
    needs_key?: boolean,
    f0_time_lock?: boolean,
    "1_0_one_way"?: boolean,
}

struct SpawnPoints{
    ...CellMeta,
    team?: Team,
    urid?: int,
}

struct Teleporters{
    ...CellMeta,
    urid?: int,
    team?: Team,
}

struct Shops{
    ...CellMeta,
    urid?: int,
}

struct CellMeta {
    /// Which floor this cell is on
    floorIdx?: int,
    /// X Coord in the grid
    x?: int,
    /// Z Coord in the grid
    z?: int
}