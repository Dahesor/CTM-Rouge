use::mcdoc::level::cell::SpawnPoints
use::ram::player_map::PlayerMap
use::mcdoc::level::cell::Cell
type Team = #[color="named"] TeamColor
enum(string) TeamColor{
    red = "red",
    blue = "blue",
    yellow = "yellow",
    green = "green"
}

dispatch minecraft:storage["team:"] to struct{
    data?: [TeamStorage],
    cell?: Cell,
    spectate?: TeamStorage
}

struct TeamStorage {
    team?: Team,
    spawn?: SpawnPoints,
    team_id?: TeamID,
    map?: PlayerMap,
}

enum(int) TeamID{
    red = 1,
    blue = 2,
    yellow = 3,
    green = 4
}