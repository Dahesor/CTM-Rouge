use::reg::item::RegistryItem

dispatch mcdoc:custom_data["__temp_item"] to boolean
dispatch mcdoc:custom_data["isTerraRestore"] to boolean
dispatch mcdoc:custom_data["shopDisplayItem"] to boolean
dispatch mcdoc:custom_data["soul_bind"] to struct {name?: string}
dispatch mcdoc:custom_data["captureIconCache"] to struct {
    urid?: int,
    icon?: string,
}

dispatch mcdoc:custom_data["inStock"] to struct shopStock {
    item?: RegistryItem,
    has_stock?: boolean,
    price?: int,
}