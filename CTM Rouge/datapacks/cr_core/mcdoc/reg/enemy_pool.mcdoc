use::reg::mob::SpawnerMob

dispatch minecraft:storage["reg:enemy_pool"] to struct {
    reg?: [EnemyPool],
    this?: EnemyPool,
    zrun?: EnemyPool,
    "_"?: struct{
        id?: string,
    }
}

struct EnemyPool{
    /// ID of this pool
    id?: EnemyPoolIDs,
    /// Mobs ID that can spawn from this pool
    contents?: [SpawnerMob],
    /// Tags that can be used to filter this pool
    tags?: [SpawnerMobSeries],
    /// Weight of this pool
    weight?: int,
    /// Average Difficulty of this pool
    average_difficulty?: int,
    /// Difficulty rating of this pool
    rating?: int @..10,
}

enum(string) EnemyPoolIDs {
    all = "all"
}


type SpawnerMobSeries = (
    "undead"|
    "overworld"|
    "overworld_night"|
    "overworld_day"|
    "cave"|
    "illager"|
    "nether"|
    "nether_fortress"|
    "nether_bastion"|
    "end"|
    "ocean"|
    "deep_dark"|
    "swamp"|
    "trial_chamber"|
    "magic"|
    "icy"|
    "any"
)